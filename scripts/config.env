# ============ 连接配置(空值必填,AI 首次使用时会逐项询问) ============

# ----- SSH(目标 CentOS 服务器)-----
SSH_HOST=""
SSH_PORT="22"
SSH_USER="root"
SSH_PASS=""          # 留空=用密钥或交互输密码;填了且本机装有 sshpass 则免交互

# ----- PostgreSQL(管理员账号) -----
# 用户名密码建议留空: 执行时会在终端询问(密码隐藏输入),不写入任何文件
PGUSER=""
PGPASSWORD=""
PGPORT="5432"
PGHOST="127.0.0.1"      # 若 pg_hba 拒绝 127.0.0.1,改成 socket 目录(如 /tmp)走本地认证
PGDATABASE="postgres"   # 重点分析的业务库,如 app_coredb;不确定先用 postgres
PSQL_BIN=""             # psql 绝对路径;留空自动探测(定制环境通常不在 PATH)

# ----- Redis -----
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASS=""
REDIS_CLI_BIN=""        # 留空自动探测

# ----- Tomcat / Java -----
TOMCAT_PID=""           # 留空=自动选 CPU 最高的 java 进程
JAVA_BIN_DIR=""         # jstack/jstat 所在目录;留空自动探测
